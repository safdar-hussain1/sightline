# datasets and heavyweight model weights never enter the repo
# (anchored to repo root on purpose — web/public assets must not be shadowed;
#  structural guard: tests/test_guards.py)
/data/
/runs/
/checkpoints/
*.pt
*.pth
*.ckpt*
*.npz

# environments and caches
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# the demo command's default output (demo.mp4 and renamed variants), in the repository root
# only: the clip videos under web/public/data/clips are tracked
# (structural guard: tests/test_guards.py)
/demo*.mp4

# node
node_modules/
/web/dist/
# a site-data build stages its files here and always removes the folder
/web/.public-*/
# and export.json beside itself, which it removes as well unless it is killed
/reports/.export.json.*

# OS noise
.DS_Store
